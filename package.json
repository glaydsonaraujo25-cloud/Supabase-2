    "format": "prettier --write src/ChampionshipDashboard.tsx src/AuthScreen.tsx src/EditDialog.tsx src/ParticipantAdminCenter.tsx src/SharingCenter.tsx src/StatisticsCenter.tsx src/KnockoutCenter.tsx src/PublicChampionship.tsx src/lib tests"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
