# ==============================
# CONFIGURAÇÃO DO SUPABASE
# ==============================

# URL pública do projeto Supabase
# Encontre em: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública do Supabase
# Use a Publishable Key (ou anon key em projetos legados)
# NUNCA coloque service_role ou Secret Key no frontend.
VITE_SUPABASE_PUBLISHABLE_KEY=SUA_PUBLISHABLE_KEY_AQUI

# URL pública da aplicação. Usada nos links de confirmação e recuperação de senha.
VITE_SITE_URL=https://supabase-2-2z3s56isf-black-8b8b.vercel.app

# ==============================
# CONFIGURAÇÕES OPCIONAIS DO APP
# ==============================

# Nome exibido pela aplicação
VITE_APP_NAME=Escala de Serviço do Exército

# Ambiente da aplicação
# Valores sugeridos: development | production
VITE_APP_ENV=development
